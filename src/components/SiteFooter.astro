---
import { siteMeta } from "../data/site";
import { withBase } from "../utils/paths";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href={withBase("/")}>xElessaway</a>
      <p class="footer-copy">Field notes, investigations, and practical security research.</p>
    </div>
    <div class="footer-links footer-links-inline">
      {
        siteMeta.nav.map((item) => (
          <a href={withBase(item.href)}>{item.label}</a>
        ))
      }
    </div>

    <div class="footer-links footer-links-inline footer-links-right">
      {
        siteMeta.socials.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
        ))
      }
    </div>
  </div>
</footer>
