---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteMeta } from "../data/site";
import { withBase } from "../utils/paths";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date | string;
  section?: string;
  tags?: string[];
  robots?: string;
}

const {
  title = siteMeta.title,
  description = siteMeta.description,
  image,
  type = "website",
  publishedTime,
  section,
  tags = [],
  robots
} = Astro.props;

const enableAnalytics = !robots?.includes("noindex");
const siteUrl = Astro.site?.href ? Astro.site.href.replace(/\/$/, "") : "https://xelessaway.me";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Ensure absolute image URL for WhatsApp / Telegram / Discord / X link preview cards
const ogImage = image
  ? (image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`)
  : `${siteUrl}/logo-me.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / WhatsApp / Telegram / Discord / LinkedIn -->
    <meta property="og:site_name" content="Ahmed Elessaway (xElessaway)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={title} />

    {publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ahmed_elessaway" />
    <meta name="twitter:creator" content="@ahmed_elessaway" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="icon" type="image/png" href={withBase("/logo-me.png")} />
    <link rel="apple-touch-icon" href={withBase("/logo-me.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
      rel="stylesheet"
    />
    {
      enableAnalytics && (
        <script
          is:inline
          data-goatcounter="https://xelessaway.goatcounter.com/count"
          async
          src="https://gc.zgo.at/count.js"
        ></script>
      )
    }
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("theme");
        const theme = savedTheme === "dark" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="ops-root">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" class="page-main">
      <slot />
    </main>
    <SiteFooter />
    <dialog class="image-lightbox" data-image-lightbox aria-label="Expanded image viewer">
      <button class="image-lightbox-close" type="button" data-image-lightbox-close aria-label="Close image viewer">
        Close
      </button>
      <img class="image-lightbox-media" data-image-lightbox-media alt="" />
      <p class="image-lightbox-caption" data-image-lightbox-caption hidden></p>
    </dialog>

    <script is:inline>
      const lightbox = document.querySelector("[data-image-lightbox]");
      const lightboxMedia = lightbox?.querySelector("[data-image-lightbox-media]");
      const lightboxCaption = lightbox?.querySelector("[data-image-lightbox-caption]");
      const lightboxClose = lightbox?.querySelector("[data-image-lightbox-close]");

      const isZoomableImage = (element) =>
        element instanceof HTMLImageElement &&
        (element.matches(".prose img") || element.matches(".challenge-image") || element.hasAttribute("data-zoomable-image"));

      const setZoomableState = () => {
        document.querySelectorAll(".prose img, .challenge-image, img[data-zoomable-image]").forEach((element) => {
          if (element instanceof HTMLImageElement) {
            element.tabIndex = 0;
            element.setAttribute("role", "button");
            element.setAttribute("aria-haspopup", "dialog");
          }
        });
      };

      const openLightbox = (image) => {
        if (!(lightbox instanceof HTMLDialogElement) || !(lightboxMedia instanceof HTMLImageElement)) {
          return;
        }

        lightboxMedia.src = image.currentSrc || image.src;
        lightboxMedia.alt = image.alt || "";

        if (lightboxCaption instanceof HTMLElement) {
          const caption = image.alt?.trim();
          lightboxCaption.textContent = caption ?? "";
          lightboxCaption.hidden = !caption;
        }

        lightbox.showModal();
      };

      const closeLightbox = () => {
        if (lightbox instanceof HTMLDialogElement && lightbox.open) {
          lightbox.close();
        }
      };

      document.addEventListener("click", (event) => {
        const target = event.target;

        if (target instanceof Element) {
          const image = target.closest(".prose img, .challenge-image, img[data-zoomable-image]");

          if (isZoomableImage(image)) {
            event.preventDefault();
            openLightbox(image);
            return;
          }
        }

        if (target === lightbox || target === lightboxClose) {
          closeLightbox();
        }
      });

      document.addEventListener("keydown", (event) => {
        const target = event.target;

        if ((event.key === "Enter" || event.key === " ") && isZoomableImage(target)) {
          event.preventDefault();
          openLightbox(target);
        }
      });

      setZoomableState();
      document.addEventListener("astro:page-load", setZoomableState);
    </script>
  </body>
</html>
