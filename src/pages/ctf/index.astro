---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

const collections = await getCollection("ctfCollections");
const challenges = await getCollection("ctfChallenges");

const stats = collections.map((entry) => {
  const collectionChallenges = challenges.filter((challenge) => challenge.data.collection === entry.slug);
  const easy = collectionChallenges.filter((challenge) => challenge.data.difficulty === "easy").length;
  const medium = collectionChallenges.filter((challenge) => challenge.data.difficulty === "medium").length;
  const hard = collectionChallenges.filter((challenge) => challenge.data.difficulty === "hard").length;

  return {
    entry,
    total: collectionChallenges.length,
    easy,
    medium,
    hard
  };
});
---

<BaseLayout
  title="Practice Lab & CTFs | Ahmed Elessaway (xElessaway)"
  description="Hands-on digital forensics, memory analysis, and OSINT challenge collections with built-in validation."
>
  <div class="archive-container">
    <!-- Header Block -->
    <header class="archive-header-block">
      <div class="archive-title-wrap">
        <div class="status-stamp"><span></span>Practice Environment Active</div>
        <h1 class="archive-headline">
          PRACTICE LAB
          <svg class="archive-squiggle" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 5 Q 50 10 100 0" fill="transparent" stroke="currentColor" stroke-width="4"></path>
          </svg>
        </h1>
        <p class="archive-subhead">
          Scenario-driven investigations, DFIR disk & memory challenges, and OSINT puzzles designed to sharpen real analyst tradecraft.
        </p>
      </div>
    </header>

    <!-- Collections Grid -->
    <div class="ctf-collections-grid">
      {
        stats.map(({ entry, total, easy, medium, hard }) => (
          <article class="archive-folder-card ctf-collection-folder">
            <div class="archive-folder-tab" aria-hidden="true"></div>
            <div class="ctf-folder-tape" aria-hidden="true"></div>

            <a href={`/ctf/${entry.slug}/`} class="archive-folder-content">
              <div class="archive-folder-top">
                <Icon name="terminal" size={24} class="archive-card-icon" />
                <span class="archive-card-tag">{entry.data.year ?? "LAB"}</span>
              </div>

              <h2 class="archive-folder-title">{entry.data.title}</h2>
              <p class="archive-folder-excerpt">{entry.data.summary}</p>

              <div class="ctf-difficulty-chips">
                {easy > 0 && <span class="difficulty-chip easy">{easy} Easy</span>}
                {medium > 0 && <span class="difficulty-chip medium">{medium} Medium</span>}
                {hard > 0 && <span class="difficulty-chip hard">{hard} Hard</span>}
              </div>
            </a>

            <div class="archive-folder-footer">
              <span class="archive-read-time">
                <Icon name="fact_check" size={16} />
                <span>{total} Challenge Nodes</span>
              </span>
              <a href={`/ctf/${entry.slug}/`} class="archive-folder-arrow" aria-label={`Open ${entry.data.title}`}>
                <span>ENTER LAB</span>
                <Icon name="east" size={16} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
