---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";

export async function getStaticPaths() {
  const collections = await getCollection("ctfCollections");
  const challenges = await getCollection("ctfChallenges");

  return collections.map((entry) => ({
    params: { collection: entry.slug },
    props: {
      entry,
      challenges: challenges
        .filter((challenge) => challenge.data.collection === entry.slug)
        .sort((a, b) => a.data.order - b.data.order)
    }
  }));
}

const { entry, challenges } = Astro.props;

const grouped = {
  easy: challenges.filter((challenge) => challenge.data.difficulty === "easy"),
  medium: challenges.filter((challenge) => challenge.data.difficulty === "medium"),
  hard: challenges.filter((challenge) => challenge.data.difficulty === "hard")
};
---

<BaseLayout
  title={`${entry.data.title} | Practice Lab`}
  description={entry.data.summary}
>
  <div class="archive-container">
    <!-- Top Back Navigation Bar -->
    <nav class="article-breadcrumb-bar">
      <a href="/ctf/" class="article-back-link">
        <Icon name="arrow_back" size={16} />
        <span>Back to All Practice Sets</span>
      </a>
      <span class="article-doc-id">SET_ID: {entry.slug.toUpperCase()}</span>
    </nav>

    <!-- Collection Header Dossier -->
    <header class="article-dossier-header">
      <div class="article-tape-sticker" aria-hidden="true"></div>
      <div class="article-meta-ribbon">
        <span class="article-type-pill">Practice Set</span>
        <span class="article-status-pill">
          <span class="pulse-dot" aria-hidden="true"></span>
          {challenges.length} MISSIONS ONLINE
        </span>
      </div>

      <h1 class="article-title">{entry.data.title}</h1>
      <p class="article-lede">{entry.data.summary}</p>
    </header>

    <!-- Grouped Challenge Grids -->
    <div class="ctf-mission-sections">
      {
        Object.entries(grouped).map(([difficulty, items]) =>
          items.length > 0 && (
            <section class="ctf-difficulty-block">
              <div class="ctf-difficulty-header">
                <span class:list={["difficulty-chip", difficulty]}>{difficulty.toUpperCase()}</span>
                <h2 class="ctf-difficulty-title">{difficulty[0].toUpperCase() + difficulty.slice(1)} Missions ({items.length})</h2>
              </div>

              <div class="archive-cards-grid">
                {items.map((challenge) => (
                  <article class="archive-folder-card ctf-mission-folder">
                    <div class="archive-folder-tab" aria-hidden="true"></div>
                    <a href={`/ctf/${entry.slug}/${challenge.slug}/`} class="archive-folder-content">
                      <div class="archive-folder-top">
                        <Icon name="flag" size={24} class="archive-card-icon" />
                        <span class="archive-card-tag">#{challenge.data.order}</span>
                      </div>

                      <h3 class="archive-folder-title">{challenge.data.title}</h3>
                      <p class="archive-folder-excerpt">{challenge.data.prompt}</p>
                    </a>

                    <div class="archive-folder-footer">
                      <span class="archive-read-time mono">Format: {challenge.data.passwordFormat}</span>
                      <a href={`/ctf/${entry.slug}/${challenge.slug}/`} class="archive-folder-arrow" aria-label={`Start ${challenge.data.title}`}>
                        <span>SOLVE</span>
                        <Icon name="east" size={16} />
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )
        )
      }
    </div>
  </div>
</BaseLayout>
