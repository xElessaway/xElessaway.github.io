---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const regularPosts = posts;

// Extract all unique tags sorted by frequency
const tagCounts = posts.reduce((acc, post) => {
  post.data.tags.forEach((tag) => {
    acc.set(tag, (acc.get(tag) ?? 0) + 1);
  });
  return acc;
}, new Map<string, number>());

const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag)
  .slice(0, 8);

// Icon mapping helper for cards
const getTagIcon = (tags: string[]) => {
  const t = tags.map((s) => s.toLowerCase());
  if (t.some((x) => x.includes("malware") || x.includes("infostealer") || x.includes("hack"))) return "bug_report";
  if (t.some((x) => x.includes("forensic") || x.includes("memory") || x.includes("dfir"))) return "memory";
  if (t.some((x) => x.includes("osint") || x.includes("investigation") || x.includes("fraud"))) return "public";
  if (t.some((x) => x.includes("network") || x.includes("wireshark") || x.includes("voip") || x.includes("pcap"))) return "terminal";
  if (t.some((x) => x.includes("ctf") || x.includes("writeup"))) return "terminal";
  return "article";
};

const getEstimatedReadingTime = (body?: string) => {
  if (!body) return "6m";
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(3, Math.round(words / 180))}m`;
};
---

<BaseLayout
  title="Research Archive | Ahmed Elessaway (xElessaway)"
  description="Investigative field notes, DFIR analyses, threat intelligence, and OSINT research cases."
>
  <div class="archive-container">
    <!-- Main Archive Header -->
    <header class="archive-header-block">
      <div class="archive-title-wrap">
        <h1 class="archive-headline">
          RESEARCH ARCHIVE
          <svg class="archive-squiggle" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 5 Q 50 10 100 0" fill="transparent" stroke="currentColor" stroke-width="4"></path>
          </svg>
        </h1>
        <p class="archive-subhead">
          Field notes, threat intelligence, reverse engineering dossiers, and forensic analysis writeups.
        </p>
      </div>

      <div class="archive-search-box">
        <Icon name="search" size={20} class="archive-search-icon" />
        <input
          type="search"
          id="archive-search-input"
          class="archive-search-input"
          placeholder="Search writeups, tags, CVEs..."
          autocomplete="off"
        />
      </div>
    </header>

    <div class="archive-layout-grid">
      <!-- Sidebar Navigation -->
      <aside class="archive-sidebar">
        <div class="archive-card archive-sidebar-index">
          <div class="archive-sidebar-profile">
            <div class="archive-profile-monogram" aria-hidden="true">xE</div>
            <div>
              <h3 class="archive-sidebar-heading">Archive Index</h3>
              <p class="archive-sidebar-meta">Sorting: Chronological</p>
            </div>
          </div>

          <nav class="archive-nav-pills" aria-label="Archive categories">
            <button
              type="button"
              class="archive-nav-btn is-active"
              data-archive-filter="all"
            >
              <Icon name="folder_open" size={18} />
              <span>All Writeups</span>
              <span class="archive-pill-count">{posts.length}</span>
            </button>
            <button
              type="button"
              class="archive-nav-btn"
              data-archive-filter="reports"
            >
              <Icon name="article" size={18} />
              <span>Reports</span>
              <span class="archive-pill-count">{posts.filter((p) => p.data.archiveSection === "reports").length}</span>
            </button>
            <button
              type="button"
              class="archive-nav-btn"
              data-archive-filter="writeups"
            >
              <Icon name="terminal" size={18} />
              <span>CTF Writeups</span>
              <span class="archive-pill-count">{posts.filter((p) => p.data.archiveSection === "writeups").length}</span>
            </button>
            <button
              type="button"
              class="archive-nav-btn"
              data-archive-tag="dfir"
            >
              <Icon name="memory" size={18} />
              <span>DFIR & Forensics</span>
            </button>
            <button
              type="button"
              class="archive-nav-btn"
              data-archive-tag="osint"
            >
              <Icon name="public" size={18} />
              <span>OSINT Cases</span>
            </button>
            <button
              type="button"
              class="archive-nav-btn"
              data-archive-tag="malware"
            >
              <Icon name="bug_report" size={18} />
              <span>Malware & TTPs</span>
            </button>
          </nav>
        </div>

        <!-- Quick Filter Tags -->
        <div class="archive-card archive-sidebar-tags">
          <h3 class="archive-sidebar-heading" style="margin-bottom: 0.8rem;">Quick Tags</h3>
          <div class="archive-tag-cloud">
            {
              topTags.map((tag) => (
                <button
                  type="button"
                  class="archive-tag-chip"
                  data-archive-tag={tag.toLowerCase()}
                >
                  #{tag}
                </button>
              ))
            }
          </div>
        </div>
      </aside>

      <!-- Main Content Canvas -->
      <section class="archive-main-canvas">
        {
          featuredPost && (
            <div class="archive-featured-bento" id="archive-featured-wrap">
              <!-- Primary Flagship Card -->
              <article class="archive-featured-card">
                <div class="archive-tape-sticker" aria-hidden="true"></div>
                <div class="archive-featured-media">
                  {featuredPost.data.cover ? (
                    <img
                      src={featuredPost.data.cover}
                      alt={featuredPost.data.title}
                      class="archive-featured-img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="archive-featured-placeholder">
                      <Icon name="security" size={54} class="archive-hero-symbol" />
                    </div>
                  )}
                  <div class="archive-featured-badge">
                    <span>Featured Investigation</span>
                  </div>
                </div>
                <div class="archive-featured-body">
                  <h2 class="archive-featured-title">
                    <a href={`/blog/${featuredPost.slug}/`}>{featuredPost.data.title}</a>
                  </h2>
                  <p class="archive-featured-desc">{featuredPost.data.description}</p>
                  <div class="archive-featured-footer">
                    <div class="archive-date-line">
                      <Icon name="calendar_today" size={16} />
                      <time datetime={featuredPost.data.publishedAt.toISOString()}>
                        {featuredPost.data.publishedAt.toLocaleDateString("en-US", {
                          month: "short",
                          day: "numeric",
                          year: "numeric"
                        })}
                      </time>
                    </div>
                    <a class="archive-read-btn" href={`/blog/${featuredPost.slug}/`}>
                      <span>READ REPORT</span>
                      <Icon name="east" size={16} />
                    </a>
                  </div>
                </div>
              </article>

              <!-- Side Feature / Field Brief -->
              <article class="archive-side-feature">
                <div class="archive-paperclip" aria-hidden="true"></div>
                <div class="archive-side-head">
                  <h3 class="archive-side-title">
                    <Icon name="warning" size={18} class="alert-symbol" />
                    <span>Threat Note</span>
                  </h3>
                </div>
                <div class="archive-side-body">
                  <h4 class="archive-side-name">TTP Triage & Infostealer Defense</h4>
                  <p class="archive-side-desc">
                    Adversary telemetry shows accelerated usage of fake software installers and demo lures to drop browser stealers.
                  </p>
                  <div class="archive-code-snippet">
                    <span class="archive-snippet-pill">ANALYSIS_NOTE</span>
                    <code># Detection hook for suspicious headless browser invocations<br/>Get-WinEvent -FilterHashtable @&#123;LogName='Security';ID=4688&#125;</code>
                  </div>
                  <div class="archive-side-footer">
                    <a class="archive-side-link" href={`/blog/${featuredPost.slug}/`}>
                      View Case Study &rarr;
                    </a>
                  </div>
                </div>
              </article>
            </div>
          )
        }

        <!-- Database Entries Section -->
        <div class="archive-entries-header">
          <h2 class="archive-section-title">Database Entries</h2>
          <div class="archive-count-badge" id="archive-count-indicator">
            Showing {regularPosts.length} entries
          </div>
        </div>

        <!-- Archive Grid of Folder Cards -->
        <div class="archive-cards-grid" id="archive-entries-list">
          {
            regularPosts.map((post) => {
              const mainTag = post.data.tags[0] ?? post.data.archiveSection;
              const icon = getTagIcon(post.data.tags);
              const readTime = getEstimatedReadingTime(post.body);
              const searchContent = `${post.data.title} ${post.data.description} ${post.data.tags.join(" ")} ${post.data.archiveSection}`.toLowerCase();

              return (
                <article
                  class="archive-folder-card"
                  data-archive-item
                  data-section={post.data.archiveSection}
                  data-tags={post.data.tags.join(",").toLowerCase()}
                  data-search={searchContent}
                >
                  <div class="archive-folder-tab" aria-hidden="true"></div>
                  <a href={`/blog/${post.slug}/`} class="archive-folder-content">
                    <div class="archive-folder-top">
                      <Icon name={icon} size={24} class="archive-card-icon" />
                      <span class="archive-card-tag">{mainTag}</span>
                    </div>

                    <h3 class="archive-folder-title">{post.data.title}</h3>
                    <p class="archive-folder-excerpt">{post.data.description}</p>
                  </a>

                  <div class="archive-folder-footer">
                    <span class="archive-read-time">
                      <Icon name="schedule" size={14} class="time-icon" />
                      <span>Read time: {readTime}</span>
                    </span>
                    <a href={`/blog/${post.slug}/`} class="archive-folder-arrow" aria-label={`Read ${post.data.title}`}>
                      <Icon name="east" size={16} />
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>

        <div id="archive-empty-state" class="archive-empty-panel" hidden>
          <Icon name="search_off" size={48} class="archive-empty-icon" />
          <h3>No matching records found</h3>
          <p>No writeups match your current search query or filter criteria. Try clearing the search or picking another tag.</p>
          <button type="button" class="button button-primary" id="archive-reset-btn">Reset Filters</button>
        </div>
      </section>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById("archive-search-input") as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll("[data-archive-filter]");
    const tagButtons = document.querySelectorAll("[data-archive-tag]");
    const cards = document.querySelectorAll("[data-archive-item]");
    const featuredWrap = document.getElementById("archive-featured-wrap");
    const countIndicator = document.getElementById("archive-count-indicator");
    const emptyState = document.getElementById("archive-empty-state");
    const resetBtn = document.getElementById("archive-reset-btn");

    let currentSection = "all";
    let currentTag: string | null = null;
    let currentQuery = "";

    function updateArchiveView() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const item = card as HTMLElement;
        const section = item.dataset.section ?? "";
        const tags = (item.dataset.tags ?? "").split(",");
        const search = item.dataset.search ?? "";

        const matchesSection = currentSection === "all" || section === currentSection;
        const matchesTag = !currentTag || tags.some((t) => t.trim().includes(currentTag!));
        const matchesQuery = !currentQuery || search.includes(currentQuery);

        if (matchesSection && matchesTag && matchesQuery) {
          item.style.display = "flex";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      // Hide or show featured hero when filtering
      if (featuredWrap) {
        if (currentSection !== "all" || currentTag || currentQuery) {
          featuredWrap.style.display = "none";
        } else {
          featuredWrap.style.display = "grid";
        }
      }

      // Update count & empty state
      if (countIndicator) {
        countIndicator.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? "entry" : "entries"}`;
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    // Search event
    searchInput?.addEventListener("input", (e) => {
      currentQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      updateArchiveView();
    });

    // Section Category filter
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => b.classList.remove("is-active"));
        tagButtons.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");

        currentSection = (btn as HTMLElement).dataset.archiveFilter ?? "all";
        currentTag = null;
        updateArchiveView();
      });
    });

    // Tag filter
    tagButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tag = (btn as HTMLElement).dataset.archiveTag ?? "";
        if (currentTag === tag) {
          // Toggle off
          currentTag = null;
          btn.classList.remove("is-active");
          document.querySelector('[data-archive-filter="all"]')?.classList.add("is-active");
          currentSection = "all";
        } else {
          tagButtons.forEach((b) => b.classList.remove("is-active"));
          filterButtons.forEach((b) => b.classList.remove("is-active"));
          btn.classList.add("is-active");
          currentTag = tag;
          currentSection = "all";
        }
        updateArchiveView();
      });
    });

    // Reset button
    resetBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      currentQuery = "";
      currentTag = null;
      currentSection = "all";
      filterButtons.forEach((b) => b.classList.remove("is-active"));
      tagButtons.forEach((b) => b.classList.remove("is-active"));
      document.querySelector('[data-archive-filter="all"]')?.classList.add("is-active");
      updateArchiveView();
    });
  </script>
</BaseLayout>
