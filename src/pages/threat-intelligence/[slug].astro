---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import SocialIcon from "../../components/SocialIcon.astro";
import { siteMeta } from "../../data/site";

export async function getStaticPaths() {
  const actors = await getCollection("actors");
  return actors.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts.filter((post) => entry.data.relatedPosts?.includes(post.slug));
---

<BaseLayout
  title={`${entry.data.name} | Threat Intelligence Dossier`}
  description={entry.data.motivation || `Tactical adversary dossier and static telemetry analysis for ${entry.data.name}`}
  type="article"
  section="Threat Intelligence"
  tags={entry.data.tags}
>
  <div class="article-dossier-container dossier-wide-container">
    <!-- Top Back Navigation Bar -->
    <nav class="article-breadcrumb-bar">
      <a href="/threat-intelligence/" class="article-back-link">
        <Icon name="arrow_back" size={16} />
        <span>Back to Threat Intelligence Feed</span>
      </a>
      <span class="article-doc-id">DOSSIER_ID: {entry.slug.toUpperCase()}</span>
    </nav>

    <!-- Unified Dossier Header Card -->
    <header class="article-dossier-header">
      <div class="article-tape-sticker" aria-hidden="true"></div>

      <div class="article-meta-ribbon">
        <span class="article-type-pill">THREAT DOSSIER</span>
        <span class:list={["article-status-pill", entry.data.status]}>
          <span class="pulse-dot" aria-hidden="true"></span>
          {entry.data.status.toUpperCase()}
        </span>
      </div>

      <h1 class="article-title">{entry.data.name}</h1>

      {entry.data.motivation && (
        <p class="article-lede">{entry.data.motivation}</p>
      )}

      <div class="article-info-strip">
        <div class="article-info-item">
          <Icon name="public" size={16} />
          <span>{entry.data.origin || "Observed Staging"}</span>
        </div>

        <div class="article-info-item">
          <Icon name="schedule" size={16} />
          <span>Active: {entry.data.firstSeen || "Observed"} &rarr; {entry.data.lastSeen || "Current"}</span>
        </div>

        {entry.data.aliases && entry.data.aliases.length > 0 && (
          <div class="article-info-item">
            <Icon name="policy" size={16} />
            <span>Aliases: {entry.data.aliases.join(", ")}</span>
          </div>
        )}
      </div>

      {entry.data.tags && entry.data.tags.length > 0 && (
        <div class="article-tags-wrap">
          {entry.data.tags.map((tag) => (
            <span class="article-tag-chip">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Main Dossier Manuscript -->
    <main class="article-manuscript-panel">
      <div class="article-prose prose">
        <Content />
      </div>

      <!-- Companion Reports (if any) -->
      {relatedPosts.length > 0 && (
        <section style="margin-top: 3rem; padding-top: 2rem; border-top: 2px solid var(--primary);">
          <div class="archive-entries-header" style="margin-bottom: 1.5rem;">
            <h2 class="archive-section-title" style="font-size: 1.3rem;">Companion Investigation Reports</h2>
          </div>
          <div class="archive-cards-grid">
            {relatedPosts.map((post) => (
              <article class="archive-folder-card">
                <div class="archive-folder-tab" aria-hidden="true"></div>
                <a href={`/blog/${post.slug}/`} class="archive-folder-content">
                  <div class="archive-folder-top">
                    <Icon name="terminal" size={24} class="archive-card-icon" />
                    <span class="archive-card-tag">REPORT</span>
                  </div>
                  <h3 class="archive-folder-title">{post.data.title}</h3>
                  <p class="archive-folder-excerpt">{post.data.description}</p>
                </a>
                <div class="archive-folder-footer">
                  <span class="archive-read-time">DFIR Analysis</span>
                  <a href={`/blog/${post.slug}/`} class="archive-folder-arrow">
                    <span>READ REPORT</span>
                    <Icon name="east" size={16} />
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Dossier Footer & Author Monogram -->
      <footer class="article-dossier-footer">
        <div class="article-author-card">
          <img src="/logo-me.png" alt="Ahmed Elessaway (xElessaway)" class="article-author-avatar-img" />
          <div class="article-author-info">
            <p class="eyebrow">Investigator / Author</p>
            <h3 class="article-author-name">Ahmed Elessaway (xElessaway)</h3>
            <p class="article-author-bio">
              Cybersecurity researcher specializing in DFIR, threat intelligence, and OSINT investigation methodologies.
            </p>
            <div class="article-author-links">
              {siteMeta.socials.map((s) => (
                <a href={s.href} target="_blank" rel="noreferrer" class="author-social-pill">
                  <SocialIcon name={s.label.toLowerCase()} size={15} />
                  <span>{s.label}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="article-nav-actions">
          <a href="/threat-intelligence/" class="button button-primary">
            <Icon name="arrow_back" size={16} />
            Back to Dossiers Feed
          </a>
          <a href="/blog/" class="button button-ghost">
            Browse Research Archive
            <Icon name="east" size={16} />
          </a>
        </div>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  .dossier-wide-container {
    max-width: 1140px;
    width: 100%;
    margin-inline: auto;
  }

  /* Prevent duplicate title when markdown includes a top-level H1 */
  .article-prose > :global(h1:first-child) {
    display: none;
  }

  .article-status-pill.tracking {
    background: #f59e0b1a;
    border-color: #f59e0b;
    color: #f59e0b;
  }
  .article-status-pill.tracking .pulse-dot {
    background: #f59e0b;
  }
  [data-theme="dark"] .article-status-pill.tracking {
    background: #f59e0b22;
    border-color: #fbbf24;
    color: #fbbf24;
  }
  [data-theme="dark"] .article-status-pill.tracking .pulse-dot {
    background: #fbbf24;
  }

  .article-status-pill.active {
    background: var(--secondary-soft);
    border-color: var(--secondary);
    color: var(--secondary);
  }

  .article-status-pill.disrupted,
  .article-status-pill.historic {
    background: var(--surface-panel);
    border-color: var(--line-soft);
    color: var(--text-soft);
  }
  .article-status-pill.disrupted .pulse-dot,
  .article-status-pill.historic .pulse-dot {
    background: var(--text-soft);
  }
</style>

