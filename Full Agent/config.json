    "actorsOutputDir": "f:/CTI/Github Profile/src/content/actors",
    "blogOutputDir": "f:/CTI/Github Profile/src/content/blog"
  },
  "defang": {
    "protocols": true,
    "ipv4": true,
    "domains": true
  }
}
